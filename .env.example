# abapsmith configuration. Copy to .env and fill in the top five —
# everything else below is optional and commented out with its default.
# ABAP_PASSWORD is one of five mutually exclusive credential methods; see
# "Credential method" below for the other four.
# Full reference: doc/CONFIGURATION/

# ---- Required ----------------------------------------------------------

ABAP_URL=https://sap.example.com:44300
ABAP_USER=DEVELOPER
ABAP_PASSWORD=
ABAP_CLIENT=001
ABAP_SID=A4H

# ---- Credential method ---------------------------------------------------
# Exactly one of five mutually exclusive credential methods must be
# configured — startup refuses to start with zero or with more than one.
# ABAP_PASSWORD above is the default: the common case, and the only method
# exercised against a live system. The other four are unverified —
# implemented and unit-tested behind fakes, but never run against a real
# system, since the reference appliance has no certificate logon and no
# OAuth server. See doc/CONFIGURATION/connection.md#authentication for
# worked examples and failure modes, and doc/LIMITATIONS/authentication.md
# for what has and hasn't been checked. Uncomment at most one block below,
# and clear ABAP_PASSWORD above if you do.

# ABAP_SESSION_COOKIE=SAP_SESSIONID_A4H_100=abcdef0123456789   # pre-obtained session cookie (e.g. captured after an interactive SSO login)

# unverified — see doc/CONFIGURATION/connection.md#authentication
# ABAP_CLIENT_CERT=/etc/abapsmith/client.pem        # X.509 client certificate: PEM or PKCS#12 (.pfx/.p12), decided by the file extension
# ABAP_CLIENT_KEY=/etc/abapsmith/client.key         # PEM private key, only if separate from ABAP_CLIENT_CERT
# ABAP_CLIENT_KEY_PASSPHRASE=                       # passphrase for the private key or the PKCS#12 file

# unverified — see doc/CONFIGURATION/connection.md#authentication
# ABAP_TOKEN=eyJhbGciOiJSUzI1NiJ9.example.token     # static bearer token, sent as Authorization: Bearer ...; never refreshed

# unverified — see doc/CONFIGURATION/connection.md#authentication
# ABAP_OAUTH_TOKEN_URL=https://sap.example.com:44300/oauth/token   # OAuth 2.0 client-credentials token endpoint
# ABAP_OAUTH_CLIENT_ID=abapsmith-client
# ABAP_OAUTH_CLIENT_SECRET=
# ABAP_OAUTH_SCOPE=                                 # optional; has no effect set on its own
# ABAP_SERVICE_KEY=/etc/abapsmith/service-key.json  # SAP BTP service-key JSON; supplies the four ABAP_OAUTH_* above, cannot combine with them

# ---- Permissions --------------------------------------------------------
# ABAP_MODE is the single permission knob: read (default, no mutation
# reaches the wire) | edit (write/activate/run, any package and any object
# name by default) | admin (edit, plus transport release, transport/cascade
# delete, source plug-ins, SAP-target enhancements — each individually
# overridable in either direction). See doc/CONFIGURATION/permissions-and-allowlists.md for the full
# ladder.
# ABAP_MODE=read

# These three sit outside the mode ladder and stay off in every mode,
# including admin, until named explicitly — each one puts business or
# personal data into the model's transcript.
# ABAP_ALLOW_DATA_PREVIEW=false     # registers abap_data_preview at all
# ABAP_ALLOW_DUMP_VARIABLES=false   # lets abap_dumps return variable contents
# ABAP_ALLOW_UI_PRESS=false         # lets abap_ui submit batch input (also needs ABAP_MODE=admin)

# ---- Common overrides ----------------------------------------------------

# ABAP_ALLOW_PACKAGES=$TMP          # write allowlist; any package by default under edit/admin, set to narrow it
# ABAP_ALLOW_NAME_PREFIXES=Z,Y      # object-name allowlist; any name by default under edit/admin, set to narrow it
# ABAP_ALLOW_TRANSPORTS=auto        # transport allowlist; auto = server may auto-select/create only; set a TRKORR to pin, or * for any
# ABAP_ALLOW_TRANSPORT_DELETE=false # deleting a transport request outright; admin-only by default, overridable either way
# ABAP_ALLOW_CASCADE_DELETE=false   # the BOPF cascading DDIC delete sweep; admin-only by default, overridable either way
# ABAP_TIMEOUT_MS=60000             # per-request HTTP timeout
# ABAP_MAX_RESPONSE_CHARS=60000     # hard cap on a single tool response
# ABAP_AVAILABLE_MEMBERS_MAX=40     # names listed per candidate list when abap_read/abap_write method= finds no such member
# ABAP_LANGUAGE=                    # ADT logon language (sap-language); empty = user's default
# ABAP_INSECURE=false               # disables TLS certificate verification — do not use against real data
# ABAP_CA_CERT=                     # CA bundle (PEM) verifying the SERVER certificate; usable with any credential method, independent of ABAP_INSECURE

# ---- MCP transport --------------------------------------------------------
# unverified as a shared deployment — see doc/LIMITATIONS/not-implemented-and-unproven.md
# ABAP_MCP_TRANSPORT is stdio by default: one process, one local conversation,
# the shape the plugin install and every example above assumes. Setting it to
# http instead serves the MCP Streamable HTTP transport over a Node http
# listener, so several MCP sessions can share one already-configured
# connection. A non-loopback ABAP_MCP_HTTP_HOST with no ABAP_MCP_HTTP_TOKEN
# set refuses to start: anything that can open a TCP connection would
# otherwise get this server's full configured SAP access as ABAP_USER. See
# doc/CONFIGURATION/transport.md and doc/SAFETY/remote-transport.md.
# ABAP_MCP_TRANSPORT=stdio          # stdio | http, case-insensitive
# ABAP_MCP_HTTP_HOST=127.0.0.1      # bind address; 0.0.0.0/:: are NOT loopback
# ABAP_MCP_HTTP_PORT=3000           # bind port; 0 asks the OS for a free one
# ABAP_MCP_HTTP_PATH=/mcp           # must start with "/"; every other path answers 404
# ABAP_MCP_HTTP_TOKEN=              # comma-separated bearer token(s); name=token records "name" as the journal actor. As sensitive as ABAP_PASSWORD.

# Full reference, including pool sizing, journal retention and debugger identity: doc/CONFIGURATION/
